{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-chat-android-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": { "ACCESS_TTL_SECONDS": "60" },
  "durable_objects": {
    "bindings": [
      { "name": "DEVICES", "class_name": "DeviceChat" },
      { "name": "RECEIPTS", "class_name": "PurchaseOwner" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DeviceChat", "PurchaseOwner"] }],
  "ratelimits": [{ "name": "AUTH_LIMIT", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
