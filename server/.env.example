HOST=127.0.0.1
PORT=8787
# Required for AI responses. Never put this key in Android code.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
ACCESS_TTL_SECONDS=60
# For actual Play verification (optional): absolute path to a service account JSON.
GOOGLE_SERVICE_ACCOUNT_FILE=
ANDROID_PACKAGE=dev.test.aichat
PLAY_PRODUCTS=chat_weekly,chat_monthly

# Optional credential failover for rejected/per-key-capped primary keys; not a rate-limit bypass.
OPENROUTER_API_KEY_BACKUP=
